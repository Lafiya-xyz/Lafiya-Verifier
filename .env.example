# Supabase (off-chain, encrypted patient profile store)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only: never expose to the browser. Required for admin writes (registration, allowlist checks).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Soroban / Stellar (attestation registry, testnet by default)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
ATTESTATION_CONTRACT_ID=your-deployed-lafiya-attestation-contract-id
# Server-only secret: the verifier service account authorized to call submit_attestation(). Never commit.
VERIFIER_SERVICE_SECRET_KEY=your-stellar-secret-key

# CHW incentive payout, in USDC, per confirmed attestation
CHW_PAYOUT_AMOUNT_USDC=2
